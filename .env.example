# TJ Cortex local configuration template
# Keep real API keys OUT of this file and OUT of Git.

# AI mode: local or api
# TJ_CORTEX_AI_MODE=local

# Local OpenAI-compatible endpoint (example: Ollama)
# TJ_CORTEX_AI_BASE_URL=http://127.0.0.1:11434/v1
# TJ_CORTEX_AI_MODEL=local-model

# API mode example
# TJ_CORTEX_AI_MODE=api
# TJ_CORTEX_AI_BASE_URL=https://api.openai.com/v1
# TJ_CORTEX_AI_MODEL=gpt-5.6
# TJ_CORTEX_AI_KEY_ENV=OPENAI_API_KEY

# Optional timeout in seconds
# TJ_CORTEX_AI_TIMEOUT=30
